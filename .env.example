# ============================================================
# Variáveis do app (prefixo VITE_). No Netlify: Site configuration > Environment variables.
# Tudo que começa com VITE_ vai para o navegador. Nunca coloque a service_role aqui.
# ============================================================

# Banco de dados. SEM estas duas, o Campuni abre em MODO DEMONSTRAÇÃO:
# publicações de exemplo, e o que o visitante publica fica só no navegador dele.
# VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON

# Endereço público (links de compartilhamento e SEO).
# VITE_SITE_URL=https://campuni.achillesmedia.com.br

# Contato oficial. Conferir com o Campuni antes de ir ao ar (DADOS-CAMPUNI.md).
# VITE_WHATSAPP=5534900000000
# VITE_EMAIL=contato@campuni.com.br
# VITE_INSTAGRAM=https://www.instagram.com/SEU_PERFIL/

# Vídeo explicativo. Aceita link do YouTube ou arquivo .mp4.
# Sem ele, a seção mostra a demonstração animada do próprio site.
# VITE_VIDEO_URL=https://www.youtube.com/watch?v=XXXXXXXXXXX

# ============================================================
# Variáveis das funções (netlify/functions). Nunca vão para o navegador.
# ============================================================
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sua_service_role
